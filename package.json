{
  "name": "sutra-ai",
  "productName": "Sutra AI",
  "version": "1.0.0",
  "description": "Sutra AI Stealth Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "launch": "node launch.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.sutraai.stealthapp",
    "productName": "Sutra AI",
    "asar": true,
    "asarUnpack": [
      "node_modules/electron/**",
      "*.env"
    ],
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Sutra AI",
        "schemes": [
          "sutra"
        ],
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sutra AI",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "launch.js",
      "frontend/**/*",
      "icon.ico",
      ".env",
      "!**/node_modules/*/{CHANGELOG.md,README.md,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,__pycache__,thumbs.db,.gitignore,.gitattributes}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ]
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3"
  }
}
